                                <Run Text=" → ONNX "/>
                                <Run Text="{Binding OnnxIndex}"/>
                                <Run Text=" / C "/>
                                <Run Text="{Binding Confidence}"/>
                                <Run Text=" / I "/>
                                <Run Text="{Binding Iou}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>

                            </TabControl>

                        </Grid>

                    </GroupBox>

                </Grid>
            </Grid>

        </Border>

    </Grid>

</Window>
