<Window x:Class="OpenCvWpfTracking.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OpenCvWpfTracking"    
        mc:Ignorable="d"
        Title="[MOE] EO/IR TEST VIEWER"
        Width="1920"
        Height="1080"
        Focusable="True"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <!-- [AI Detector] 설정 패널 공통 버튼 스타일 -->
        <Style x:Key="AiSettingButtonStyle"
               TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Margin"
                    Value="0,5,0,0"/>
        </Style>

        <!-- [장비 제어] 일반 버튼 스타일 -->
        <Style x:Key="DeviceControlButtonStyle"
           TargetType="Button">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Height"
                    Value="30"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Opacity"
                            Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- [장비 연결] 버튼 스타일 -->
        <Style x:Key="ConnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#2F4F5F"/>
        </Style>

        <!-- [연결 해제] 버튼 스타일 -->
        <Style x:Key="DisconnectButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#4A2F2F"/>
        </Style>

        <!-- [PAN/TILT] 방향 버튼 스타일 -->
        <Style x:Key="PanTiltDirectionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#37474F"/>
            <Setter Property="Margin"
                    Value="4"/>
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="18"/>
        </Style>

        <!-- [STOP] 버튼 스타일 -->
        <Style x:Key="StopButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#7A2525"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="BorderBrush"
                    Value="#708090"/>
            <Setter Property="FontSize"
                    Value="10"/>
        </Style>

        <!-- [EO] 제어 버튼 스타일 -->
        <Style x:Key="EoControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#30475A"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- [EO] Focus RepeatButton 스타일 -->
        <Style x:Key="EoFocusRepeatButtonStyle"
               TargetType="RepeatButton">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Background"
                    Value="#30475A"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                        Value="True">
                    <Setter Property="Opacity"
                            Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- [IR] 제어 버튼 스타일 -->
        <Style x:Key="IrControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#4A405F"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>

        <!-- [LRF] 제어 버튼 스타일 -->
        <Style x:Key="LrfControlButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DeviceControlButtonStyle}">
            <Setter Property="Background"
                    Value="#35514F"/>
            <Setter Property="Height"
                    Value="32"/>
            <Setter Property="FontSize"
                    Value="12"/>
        </Style>


        <!-- [우측 제어 패널] Tab Header 스타일 -->
        <Style x:Key="RightPanelTabItemStyle"
       TargetType="TabItem">

            <Setter Property="Foreground"
            Value="#D0D7DE"/>

            <Setter Property="FontWeight"
            Value="Bold"/>

            <Setter Property="FontSize"
            Value="12"/>

            <!-- 탭 사이 간격 -->
            <Setter Property="Margin"
                    Value="0,0,1,0"/>

            <!-- 탭이 남는 공간을 균등하게 사용하도록 설정 -->
            <Setter Property="HorizontalContentAlignment"
            Value="Stretch"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="TabItem">

                        <Border x:Name="TabBorder"
                                Width="190"
                                Height="38"
                                Background="#4F5860"
                                BorderBrush="#95A5B0"
                                BorderThickness="1,1,1,0"
                                CornerRadius="5,5,0,0"
                                Padding="14,8">

                            <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                             Value="True">

                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="#5F666D"/>

                                <Setter TargetName="TabBorder"
                                Property="BorderBrush"
                                Value="#AAB4BE"/>

                                <Setter Property="Foreground"
                                Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="TabBorder"
                                Property="Background"
                                Value="#3B5F70"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- [통신 설정] 입력 TextBox 스타일 -->
        <Style x:Key="CommunicationTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Foreground" Value="#20242A"/>
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="BorderBrush" Value="#AAB4BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- [통신 설정] 상태 표시 원형 -->
        <Style x:Key="ConnectionStatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="#FF6B6B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- 메인 화면 전체 레이아웃 -->
    <Grid Margin="10"
          Background="#2C313A">

        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="1.4*"/>
        </Grid.RowDefinitions>

        <!-- 상단 영역 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- [EO] 영상 영역 -->
                <ColumnDefinition Width="1.6*" />

                <!-- [IR] 영상 영역 -->
                <ColumnDefinition Width="1*" />

                <!-- 장비 제어 패널 -->
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <!-- [좌측] 큰 영상 -->
            <Border Grid.Column="0"
                    Margin="5,5,10,0"
                    Background="Black"
                    BorderBrush="#5A5A5A"
                    BorderThickness="2">
                <Grid ClipToBounds="True">

                    <!-- [EO] 영상 -->
                    <Image Source="{Binding EOCameraImage}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"/>

                    <!-- [AI] [Bounding Box] [Overlay] -->
                    <Viewbox Stretch="Uniform"
                             Visibility="Visible"
                             IsHitTestVisible="False">

                        <ItemsControl ItemsSource="{Binding EoDetectionBoxes}"
                                      Width="{Binding EoVideoWidth}"
                                      Height="{Binding EoVideoHeight}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="{Binding Width,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            Height="{Binding Height,
                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            ClipToBounds="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- [AI] [Bounding Box] 표시 영역 -->
                                    <Grid>
                                        <!-- [AI] 탐지 객체 [Bounding Box] -->
                                        <Rectangle Width="{Binding Width}"
                                                   Height="{Binding Height}"
                                                   Stroke="#FFFF0000"
                                                   StrokeThickness="4" />
                                        <!-- [AI] 탐지 객체 이름 / 정확도 표시 -->
                                        <Border Background="#FFFF0000"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding DisplayText}"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Padding="5,1" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </Viewbox>

                    <!-- 안내 문자 (왼쪽 상하단에 보이게) -->
                    <TextBlock Text="{Binding EoStatusText}"
                               Margin="0,0,8,2"
                               Foreground="#7FB3E6"
                               FontSize="15.5"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- [우측] IR 영상 -->
            <Grid Grid.Column="1"
                  Margin="0,5,10,0">

                <Border Background="Black"
                        BorderBrush="#5A5A5A"
                        BorderThickness="2">

                    <Grid ClipToBounds="True">

                        <!-- [IR] 영상 -->
                        <Image Source="{Binding IRCameraImage}"
                               Stretch="Uniform"/>

                        <!-- [AI] [Bounding Box] [Overlay] -->
                        <Viewbox Stretch="Uniform"
                                 IsHitTestVisible="False">

                            <ItemsControl ItemsSource="{Binding IrDetectionBoxes}"
                                          Width="{Binding IrVideoWidth}"
                                          Height="{Binding IrVideoHeight}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding Width,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                Height="{Binding Height,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ClipToBounds="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left"
                                                Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- [AI] [Bounding Box] 표시 영역 -->
                                        <Grid>

                                            <!-- [AI] 탐지 객체 [Bounding Box] -->
                                            <Rectangle Width="{Binding Width}"
                                                       Height="{Binding Height}"
                                                       Stroke="#FFFF0000"
                                                       StrokeThickness="4"/>

                                            <!-- [AI] 탐지 객체 이름 / 정확도 표시 -->
                                            <Border Background="#FFFF0000"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">

                                                <TextBlock Text="{Binding DisplayText}"
                                                           Foreground="White"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Padding="5,1"/>
                                            </Border>

                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Viewbox>

                        <!-- [IR] 상태 표시 -->
                        <TextBlock Text="{Binding IrStatusText}"
                                   Margin="0,0,8,2"
                                   Foreground="#C4B5FD"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   IsHitTestVisible="False"/>

                    </Grid>

                </Border>

            </Grid>

            <!-- 우측 제어 패널 -->
            <!-- 우측 통신 설정 / 운용 제어 패널 -->
            <!-- 우측 통신 설정 / 운용 제어 패널 -->
            <Border Grid.Column="2"
                    Margin="0,5,8,0"
                    Background="#646A71"
                    BorderBrush="#8B949E"
                    BorderThickness="2"
                    CornerRadius="5"
                    Padding="8,8,10,8">
                <TabControl Background="#5F666D"
                            BorderBrush="#95A5B0"
                            BorderThickness="1"
                            Padding="4,4,6,4"
                            Margin="0"
                            HorizontalContentAlignment="Stretch"
                            ItemContainerStyle="{StaticResource RightPanelTabItemStyle}">

                    <!-- Web Agent 통신 연결 설정 -->
                    <TabItem Header="통신 설정">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="5">

                                <!-- Web Agent 통신 설정 카드 -->
                                <Border Background="#5F666D"
                                        BorderBrush="#95A5B0"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="8"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="WEB AGENT 통신 설정"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,10"/>

                                        <Border Background="#40464D"
                                                BorderBrush="#95A5B0"
                                                BorderThickness="1"
                                                Padding="9">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="85"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           Text="Web Agent 제어 TCP"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           VerticalAlignment="Center"/>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">

                                                    <!-- Web Agent 연결 상태 표시등 -->
                                                    <Ellipse Width="8"
                                                             Height="8"
                                                             Fill="{Binding WebAgentConnectionStatusColor}"
                                                             VerticalAlignment="Center"/>

                                                    <!-- Web Agent 연결 상태 문자열 -->
                                                    <TextBlock Text="{Binding WebAgentConnectionStatusText}"
                                                               Foreground="{Binding WebAgentConnectionStatusColor}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Margin="5,0,0,0"
                                                               VerticalAlignment="Center"/>

                                                </StackPanel>

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Text="IP ADDRESS"
                                                           Foreground="#D0D7DE"
                                                           FontSize="11"
                                                           Margin="0,10,0,4"/>

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Text="PORT"
                                                           Foreground="#D0D7DE"
                                                           FontSize="11"
                                                           Margin="6,10,0,4"/>

                                                <TextBox Grid.Row="2"
                                                         Grid.Column="0"
                                                         Style="{StaticResource CommunicationTextBoxStyle}"
                                                         Text="{Binding WebAgentIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <TextBox Grid.Row="2"
                                                         Grid.Column="1"
                                                         Margin="6,0,0,0"
                                                         Style="{StaticResource CommunicationTextBoxStyle}"
                                                         Text="{Binding WebAgentPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                                <Grid Grid.Row="3"
                                                      Grid.ColumnSpan="2"
                                                      Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Height="32"
                                                            Content="장비 연결"
                                                            Style="{StaticResource ConnectButtonStyle}"
                                                            Command="{Binding ConnectCommand}"/>

                                                    <Button Grid.Column="2"
                                                            Height="32"
                                                            Content="연결 해제"
                                                            Style="{StaticResource DisconnectButtonStyle}"
                                                            Command="{Binding DisconnectCommand}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 영상 및 장비 상태 카드 -->
                                <Border Background="#5F666D"
                                        BorderBrush="#95A5B0"
                                        BorderThickness="1.5"
                                        CornerRadius="5"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CONNECTION STATUS"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>

                                        <Border Background="#40464D"
                                                BorderBrush="#76818B"
                                                BorderThickness="1"
                                                Padding="9">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="2" Text="POWER" Foreground="#D0D7DE" Margin="0,6,0,3"/>
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           FontWeight="Bold"
                                                           Margin="0,6,0,3">

                                                <Run Text="CONTROL:"
                                                    Foreground="#4FD1C5"/>

                                                <Run Text="{Binding CurrentControlPowerText,
                                                                    Mode=OneWay}"
                                                    Foreground="#9FE870"/>

                                                <Run Text=" / "
                                                    Foreground="#D0D7DE"/>

                                                <Run Text="EO:"
                                                    Foreground="#7DD3FC"/>

                                                <Run Text="{Binding CurrentEoPowerText,
                                                                    Mode=OneWay}"
                                                    Foreground="#9FE870"/>

                                                <Run Text=" / "
                                                    Foreground="#D0D7DE"/>

                                                <Run Text="IR:"
                                                    Foreground="#C4B5FD"/>

                                                <Run Text="{Binding CurrentIrPowerText,
                                                                    Mode=OneWay}"
                                                    Foreground="#9FE870"/>

                                                </TextBlock>
                                            </Grid>

                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- 기존 장비 제어 UI -->
                    <TabItem Header="운용 제어">
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="175"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                            Background="#5F666D"
                            BorderBrush="#95A5B0"
                            BorderThickness="1.5"
                            Padding="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- 제목 -->
                                        <RowDefinition Height="Auto"/>
                                        <!-- 장비 리스트 -->
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 제어 패널 Scroll 영역 -->
                                    <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Vertical" 
                                            Margin="0,0,0,10">

                                            <!-- 테스트용 장비 선택 RadioButton 
                                         현재는 단일 장비 연결 구조로 사용하므로
                                         임시 비활성화 처리.
                                         추후 다중 장비 선택 기능 추가 시 재사용 예정 -->
                                            <!--<RadioButton Content="연결 해제"
                                                 Foreground="#6EC1FF"
                                                 FontSize="15"
                                                 Margin="0,5"/>                      
                                    <RadioButton Content="TORUSS-LR1000"
                                                 Foreground="#6EC1FF"
                                                 FontSize="15"
                                                 Margin="0,5"/>-->

                                            <!-- [PAN] / [TILT] 제어 -->
                                            <Border Grid.Row="2"
                                            Margin="0,5,5,0"
                                            Background="#5F666D"
                                            BorderBrush="#95A5B0"
                                            BorderThickness="1.5"
                                            Padding="12">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 제목 -->
                                                    <TextBlock Text="PAN / TILT CONTROL"
                                                       HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,5"/>

                                                    <!-- [PT] 방향키 제어 버튼 영역 -->
                                                    <Grid Grid.Row="1"
                                                  Width="120"
                                                  Height="120"
                                                  HorizontalAlignment="Center">

                                                        <Grid.RowDefinitions>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- [PAN LEFT + TILT UP] 좌측 상단 대각선 -->
                                                        <Button Grid.Row="0"
                                                        Grid.Column="0"
                                                        Content="↖"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanLeftTiltUp_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [TILT] [UP] -->
                                                        <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Content="▲"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="TiltUp_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [PAN RIGHT + TILT UP] 우측 상단 대각선 -->
                                                        <Button Grid.Row="0"
                                                        Grid.Column="2"
                                                        Content="↗"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanRightTiltUp_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [PAN] [LEFT] -->
                                                        <Button Grid.Row="1"
                                                        Grid.Column="0"
                                                        Content="◀"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanLeft_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [STOP] -->
                                                        <Border Grid.Row="1"
                                                        Grid.Column="1"
                                                        Margin="5"
                                                        Background="#3F454B"
                                                        BorderBrush="#8B949E"
                                                        BorderThickness="1">

                                                            <Button Content="STOP"
                                                            Style="{StaticResource StopButtonStyle}"
                                                            Command="{Binding StopMoveCommand}"/>
                                                        </Border>

                                                        <!-- [PAN] [RIGHT] -->
                                                        <Button Grid.Row="1"
                                                        Grid.Column="2"
                                                        Content="▶"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanRight_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [PAN LEFT + TILT DOWN] 좌측 하단 대각선 -->
                                                        <Button Grid.Row="2"
                                                        Grid.Column="0"
                                                        Content="↙"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanLeftTiltDown_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [TILT] [DOWN] -->
                                                        <Button Grid.Row="2"
                                                        Grid.Column="1"
                                                        Content="▼"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="TiltDown_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                        <!-- [PAN RIGHT + TILT DOWN] 우측 하단 대각선 -->
                                                        <Button Grid.Row="2"
                                                        Grid.Column="2"
                                                        Content="↘"
                                                        Style="{StaticResource PanTiltDirectionButtonStyle}"
                                                        PreviewMouseDown="PanRightTiltDown_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave"/>

                                                    </Grid>

                                                    <!-- 이동 단위 표시 -->
                                                    <TextBlock Grid.Row="2"
                                                       Text="{Binding PanTiltSpeedLevel,StringFormat=PT SPEED LV : {0}}"
                                                       Foreground="#D0D7DE"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- [EO] [ZOOM] / [FOCUS] 제어 -->
                                            <Border Grid.Row="2"
                                            Margin="0,5,5,0"
                                            Background="#5F666D"
                                            BorderBrush="#95A5B0"
                                            BorderThickness="1.5"
                                            Padding="12">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 제목 -->
                                                    <TextBlock Text="EO ZOOM / FOCUS CONTROL"
                                                       HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,5"/>

                                                    <!-- [EO] [ZOOM] 제어 -->
                                                    <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10">

                                                        <!-- [EO] [ZOOM] 확대 -->
                                                        <Button Content="ZOOM +"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource EoControlButtonStyle}"
                                                        PreviewMouseDown="EoZoomIn_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                        <!-- [EO] [ZOOM] 축소 -->
                                                        <Button Content="ZOOM -"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource EoControlButtonStyle}"
                                                        PreviewMouseDown="EoZoomOut_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                    </StackPanel>

                                                    <!-- [EO] [FOCUS] 제어 -->
                                                    <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,0">

                                                        <!-- [EO] Focus Near
                                                     누르고 있는 동안 Near 연속 이동
                                                     버튼 해제 시 Stop -->
                                                        <Button Content="FOCUS +"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource EoControlButtonStyle}"
                                                        PreviewMouseDown="EoFocusNear_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave" />

                                                        <!-- [EO] Focus Far
                                                     누르고 있는 동안 Far 연속 이동
                                                     버튼 해제 시 Stop -->
                                                        <Button Content="FOCUS -"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource EoControlButtonStyle}"
                                                        PreviewMouseDown="EoFocusFar_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseLeave" />

                                                    </StackPanel>

                                                    <!-- [EO] [One Push Focus] 제어 -->
                                                    <!--<Button Grid.Row="3"
                                                    Content="AUTO FOCUS"
                                                    Width="180"
                                                    Margin="5,5,5,0"
                                                    HorizontalAlignment="Center"
                                                    Focusable="False"
                                                    Style="{StaticResource EoControlButtonStyle}"
                                                    PreviewMouseDown="EoAutoFocus_MouseDown"/>-->

                                                </Grid>
                                            </Border>

                                            <!-- [IR] [ZOOM] / [FOCUS] 제어 -->
                                            <Border Grid.Row="2"
                                            Margin="0,5,5,0"
                                            Background="#5F666D"
                                            BorderBrush="#95A5B0"
                                            BorderThickness="1.5"
                                            Padding="12">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- 제목 -->
                                                    <TextBlock Text="IR ZOOM / FOCUS CONTROL"
                                                       HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,5"/>

                                                    <!-- [IR] [ZOOM] 제어 -->
                                                    <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10">

                                                        <!-- [IR] [ZOOM] 확대 -->
                                                        <Button Content="ZOOM +"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource IrControlButtonStyle}"
                                                        PreviewMouseDown="IrZoomIn_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                        <!-- [IR] [ZOOM] 축소 -->
                                                        <Button Content="ZOOM -"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource IrControlButtonStyle}"
                                                        PreviewMouseDown="IrZoomOut_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                    </StackPanel>

                                                    <!-- [IR] [FOCUS] 제어 -->
                                                    <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,0,0,10">

                                                        <!-- [IR] [FOCUS] [Far] -->
                                                        <Button Content="FOCUS +"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource IrControlButtonStyle}"
                                                        PreviewMouseDown="IrFocusFar_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                        <!-- [IR] [FOCUS] [Near] -->
                                                        <Button Content="FOCUS -"
                                                        Width="85"
                                                        Margin="5"
                                                        Focusable="False"
                                                        Style="{StaticResource IrControlButtonStyle}"
                                                        PreviewMouseDown="IrFocusNear_MouseDown"
                                                        PreviewMouseUp="MoveStop_MouseUp"
                                                        MouseLeave="MoveStop_MouseUp"/>

                                                    </StackPanel>

                                                    <!-- [IR] [Auto Focus] 제어 -->
                                                    <Button Grid.Row="4"
                                                    Content="AUTO FOCUS"
                                                    Width="180"
                                                    Margin="5"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource IrControlButtonStyle}"
                                                    PreviewMouseDown="IrAutoFocus_MouseDown"/>

                                                </Grid>
                                            </Border>

                                            <!-- [LRF] 제어 -->
                                            <!--<Border Grid.Row="2"
                                            Margin="0,10,10,0"
                                            Background="#5F666D"
                                            BorderBrush="#95A5B0"
                                            BorderThickness="1.5"
                                            Padding="10">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            -->
                                            <!-- 제목 -->
                                            <!--
                                            <TextBlock Text="LRF CONTROL"
                                                       HorizontalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,8"/>

                                            -->
                                            <!-- [LRF] [1회] 거리 측정 -->
                                            <!--
                                            <Button Grid.Row="1"
                                                    Content="MEASURE"
                                                    Width="180"
                                                    Margin="5"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource LrfControlButtonStyle}"
                                                    Command="{Binding LrfMeasureCommand}"/>

                                            -->
                                            <!-- 추후 거리값 표시 영역 -->
                                            <!--
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding LrfDistanceText}"
                                                       Foreground="#D0D7DE"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,10,0,0"/>
                                        </Grid>
                                    </Border>-->

                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Margin="0,10,0,0"
                                    Background="#4E555C"
                                    BorderBrush="#95A5B0"
                                    BorderThickness="1.5"
                                    Padding="10">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 제목 -->
                                    <TextBlock Grid.Row="0"
                                               Text="CURRENT STATUS"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>

                                    <!-- 상태값 -->
                                    <Grid Grid.Row="1">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- PAN -->
                                        <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="Pan"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                        <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                        <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Text="{Binding CurrentPanText}"
                                           Foreground="White"/>

                                        <!-- TILT -->
                                        <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="Tilt"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                        <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Text="{Binding CurrentTiltText}"
                                           Foreground="White"/>

                                        <!-- EO ZOOM -->
                                        <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="EO Zoom"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                        <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                        <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Text="{Binding CurrentEoZoomText}"
                                           Foreground="White"/>

                                        <!-- EO FOCUS -->
                                        <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="EO Focus"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                        <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                        <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Text="{Binding CurrentEoFocusText}"
                                           Foreground="White"/>

                                        <!-- IR ZOOM -->
                                        <!--
                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Text="IR Zoom"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Text="{Binding CurrentIrZoomText}"
                                           Foreground="White"/>

                                -->
                                        <!-- IR FOCUS -->
                                        <!--
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Text="IR Focus"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                <TextBlock Grid.Row="5"
                                           Grid.Column="1"
                                           Text=":"
                                           Foreground="White"/>

                                <TextBlock Grid.Row="5"
                                           Grid.Column="2"
                                           Text="{Binding CurrentIrFocusText}"
                                           Foreground="White"/>-->

                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>

        <!-- [AI Detector] 설정 패널 -->
        <Border Grid.Row="1"
                Margin="5,5,5,5"
                Background="#20262D"
                BorderBrush="#4F6773"
                BorderThickness="2"
                CornerRadius="5"
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 제목 -->
                <TextBlock Grid.Row="0"
                           Text="AI DETECTOR SETTING"
                           Foreground="#00B8D4"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- AI Agent -->
                        <ColumnDefinition Width="1.1*"/>
                        <!-- RTSP Setting -->
                        <ColumnDefinition Width="2.1*"/>
                        <!-- Mapping Setting -->
                        <ColumnDefinition Width="1.6*"/>
                        <!-- Display -->
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- [1] AI Agent 연결 설정 -->
                    <GroupBox Grid.Column="0"
                              Header="AI Agent"
                              Foreground="White"
                              BorderBrush="#90A4AE"
                              Margin="0,0,10,0">

                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="IP"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Height="24"
                                     Margin="0,0,0,5"
                                     Text="{Binding AiAgentIp, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Port"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Height="24"
                                     Margin="0,0,0,5"
                                     Text="{Binding AiAgentPort, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Content="AI CONNECT"
                                    Style="{StaticResource AiSettingButtonStyle}"
                                    Background="#1F4F4A"
                                    Command="{Binding ConnectAiAgentCommand}"/>
                        </Grid>

                    </GroupBox>

                    <!-- [2] RTSP 주소 설정 -->
                    <GroupBox Grid.Column="1"
                              Header="RTSP Setting"
                              Foreground="White"
                              BorderBrush="#90A4AE"
                              Margin="0,0,10,0">

                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="RTSP 0"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Height="24"
                                     Margin="0,0,0,5"
                                     Text="{Binding AiRtsp0Address, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="RTSP 1"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Height="24"
                                     Margin="0,0,0,5"
                                     Text="{Binding AiRtsp1Address, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Content="APPLY RTSP"
                                    Style="{StaticResource AiSettingButtonStyle}"
                                    Background="#263B4A"
                                    Command="{Binding ApplyAiRtspCommand}"/>
                        </Grid>

                    </GroupBox>

                    <!-- [3] Mapping 설정 -->
                    <GroupBox Grid.Column="2"
                              Header="Mapping Setting"
                              Foreground="White"
                              BorderBrush="#90A4AE"
                              Margin="0,0,10,0">

                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="ONNX (RTSP 0)"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Height="24"
                                      Margin="0,0,0,5"
                                      ItemsSource="{Binding AiOnnxList}"
                                      SelectedValue="{Binding AiRtsp0OnnxIndex, Mode=TwoWay}"
                                      SelectedValuePath="Index"
                                      DisplayMemberPath="FileName"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="ONNX (RTSP 1)"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Height="24"
                                      Margin="0,0,0,5"
                                      ItemsSource="{Binding AiOnnxList}"
                                      SelectedValue="{Binding AiRtsp1OnnxIndex, Mode=TwoWay}"
                                      SelectedValuePath="Index"
                                      DisplayMemberPath="FileName"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Confidence"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <Slider Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding AiMappingConfidence, Mode=TwoWay}"
                                    Margin="0,0,10,5"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="{Binding AiMappingConfidenceText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Text="IOU"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <Slider Grid.Row="3"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding AiMappingIou, Mode=TwoWay}"
                                    Margin="0,0,10,5"/>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="2"
                                       Text="{Binding AiMappingIouText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <Button Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    Content="APPLY MAPPING"
                                    Style="{StaticResource AiSettingButtonStyle}"
                                    Background="#34505F"
                                    Command="{Binding ApplyAiMappingCommand}"/>
                        </Grid>

                    </GroupBox>

                    <!-- [4] 표시 / 조회 설정 -->
                    <GroupBox Grid.Column="3"
                              Header="Display / Query"
                              Foreground="White"
                              BorderBrush="#90A4AE">

                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="45"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Box Filter"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,5"/>

                            <Slider Grid.Row="0"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding AiDisplayConfidenceThreshold, Mode=TwoWay}"
                                    Margin="0,0,10,5"/>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="{Binding AiDisplayConfidenceThresholdText}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,0,5"/>

                            <CheckBox Grid.Row="1"
                                      Grid.ColumnSpan="2"
                                      Content="AUTO TRACKING"
                                      Foreground="#00E676"
                                      FontWeight="Bold"
                                      IsChecked="{Binding IsAutoTrackingEnabled}"
                                      Margin="0,5,0,5"/>

                            <Button Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Content="REFRESH AI INFO"
                                    Style="{StaticResource AiSettingButtonStyle}"
                                    Background="#3A4058"
                                    Command="{Binding RefreshAiSettingCommand}"/>

                            <TextBlock Grid.Row="3"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding AiSettingStatusText}"
                                       Foreground="#00E676"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,6"/>

                            <TabControl Grid.Row="4"
                                        Grid.ColumnSpan="3"
                                        FontSize="11">

                                <TabItem Header="RTSP">
                                    <ListBox ItemsSource="{Binding AiRtspList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Index}"/>
                                <Run Text=" : "/>
                                <Run Text="{Binding Url}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </TabItem>

                                <TabItem Header="ONNX">
                                    <ListBox ItemsSource="{Binding AiOnnxList}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Index}"/>
                                    <Run Text=" : "/>
                                    <Run Text="{Binding FileName}"/>
                                                    </TextBlock>
                                                </StackPanel>
